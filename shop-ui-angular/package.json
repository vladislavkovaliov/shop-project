{
  "name": "shop-ui-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node dist/shop-ui-angular/server/server.mjs",
    "dev": "ng build && concurrently -n ssr,ng \"node dist/shop-ui-angular/server/server.mjs\" \"ng serve\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:shop-ui-angular": "node dist/shop-ui-angular/server/server.mjs",
    "api": "dotenv -e .env -- sh -c 'npx swagger-typescript-api generate -p \"${PUBLIC_PROTOCOL}://${PUBLIC_URL}:${PUBLIC_PORT}/${PUBLIC_PATH}\" -o src/lib/types -n api.ts --no-client --extract-request-params --extract-response-body'"
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.14",
    "@better-auth/drizzle-adapter": "^1.6.19",
    "better-auth": "^1.6.19",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "postgres": "^3.4.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "concurrently": "^9.2.3",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
